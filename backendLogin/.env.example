# Copy this file to backendLogin/.env and fill in your values. .env is ignored by git, so the keys stay private.
# Find them in the Supabase dashboard > Project Settings > API Keys (and Data API for the URL).

SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co

# The SECRET key (sb_secret_...) or the older service_role key. It can read and write everything,
# so never put it in frontend/ or share it.
SUPABASE_SECRET_KEY=PASTE-YOUR-SECRET-OR-SERVICE-ROLE-KEY-HERE
